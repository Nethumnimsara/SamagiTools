:root{--navy:#0b2d6b;--blue:#1876e8;--pale:#eef6ff;--ink:#10213f;--muted:#66748b;--line:#dce7f4;--white:#fff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}button,input,select{font:inherit}.nav{height:78px;position:sticky;top:0;z-index:30;background:rgba(255,255,255,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(220,231,244,.7);display:flex;align-items:center;padding:0 5%;gap:34px}.brand img{width:126px;height:64px;object-fit:contain;border-radius:12px}.nav nav{display:flex;gap:26px;margin:auto}.nav nav a{font-size:13px;font-weight:600;color:#41516b}.nav nav a:hover{color:var(--blue)}.navActions{display:flex;align-items:center;gap:10px}.iconBtn,.cartBtn,.menuBtn,.carouselBtns button{border:1px solid var(--line);background:#fff;border-radius:12px;height:42px;padding:0 12px;cursor:pointer}.waBtn,.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;border-radius:12px;padding:13px 18px;font-weight:700;font-size:13px}.waBtn,.primary{background:var(--blue);color:#fff}.secondary{border:1px solid var(--line);background:#fff;color:var(--navy)}.cartBtn b{background:var(--navy);color:#fff;border-radius:99px;padding:3px 7px;font-size:10px;margin-left:3px}.menuBtn{display:none}.hero{min-height:650px;background:linear-gradient(135deg,#f8fbff 0%,#e9f3ff 55%,#dcecff 100%);display:grid;grid-template-columns:1.05fr .95fr;align-items:center;padding:80px 8%;position:relative;overflow:hidden}.heroGlow{position:absolute;width:650px;height:650px;border-radius:50%;right:-150px;top:-120px;background:radial-gradient(circle,rgba(24,118,232,.18),transparent 68%)}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--blue);font-weight:800}.hero h1{font-size:clamp(48px,6vw,82px);line-height:.98;margin:18px 0;color:var(--navy);letter-spacing:-4px}.hero h1 span{color:var(--blue)}.hero p{max-width:520px;color:var(--muted);font-size:17px;line-height:1.7}.heroBtns{display:flex;gap:12px;margin-top:30px}.heroVisual{height:450px;display:grid;place-items:center;position:relative}.toolPanel{width:min(370px,80%);height:390px;border:1px solid rgba(255,255,255,.9);border-radius:34px;background:linear-gradient(160deg,rgba(11,45,107,.98),rgba(24,118,232,.92));box-shadow:0 30px 70px rgba(11,45,107,.25);padding:28px;color:#fff;transform:rotate(3deg);animation:float 5s ease-in-out infinite}.panelTop{display:flex;justify-content:space-between;font-size:11px;letter-spacing:2px;opacity:.8}.giantTool{font-size:130px;text-align:center;margin:50px 0 25px;filter:drop-shadow(0 15px 15px rgba(0,0,0,.18))}.toolLines{display:flex;gap:7px}.toolLines i{display:block;height:4px;background:#fff;border-radius:99px;opacity:.4}.toolLines i:first-child{width:70%}.toolLines i:nth-child(2){width:20%}.toolLines i:nth-child(3){width:10%}.toolPanel strong{display:block;margin-top:25px}.orbit{position:absolute;font-size:34px;animation:spin 8s linear infinite}.o1{left:8%;top:18%}.o2{right:10%;bottom:16%;animation-direction:reverse}@keyframes float{50%{transform:rotate(-1deg) translateY(-12px)}}@keyframes spin{to{transform:rotate(360deg)}}.trust{display:grid;grid-template-columns:repeat(4,1fr);background:var(--navy);color:#fff;padding:24px 8%}.trust div{padding:10px 20px;border-right:1px solid rgba(255,255,255,.15);display:flex;flex-direction:column;gap:5px}.trust div:last-child{border:0}.trust strong{font-size:25px}.trust span{font-size:11px;color:#b9c9e2}.section{padding:100px 8%}.sectionHead{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}.section h2{font-size:42px;letter-spacing:-2px;margin:10px 0}.sectionHead p{color:var(--muted);margin:0}.catGrid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}.catGrid button{background:#f7faff;border:1px solid var(--line);border-radius:20px;padding:28px 10px;display:flex;flex-direction:column;align-items:center;gap:12px;color:var(--navy);font-weight:700;cursor:pointer;transition:.25s}.catGrid button:hover{transform:translateY(-6px);border-color:#a9c9ef;box-shadow:0 15px 35px rgba(22,80,150,.1)}.catGrid button:first-letter{font-size:28px}.shop{background:#f8fbff}.shopControls{display:flex;gap:10px}.searchBox{height:44px;border:1px solid var(--line);border-radius:12px;background:#fff;display:flex;align-items:center;padding:0 12px;min-width:230px}.searchBox input{border:0;outline:0;width:100%;padding:0 8px}.shopControls select{border:1px solid var(--line);border-radius:12px;background:#fff;padding:0 12px;color:var(--ink)}.productGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;position:relative;transition:.3s;display:flex;flex-direction:column}.product:hover{transform:translateY(-7px);box-shadow:0 20px 45px rgba(16,33,63,.1)}.productImg{height:220px;background:#f1f5fa;display:grid;place-items:center;overflow:hidden;cursor:pointer}.productImg img{width:100%;height:100%;object-fit:cover;transition:.5s}.product:hover .productImg img{transform:scale(1.05)}.productBody{padding:17px;display:flex;flex-direction:column;gap:8px;flex:1}.tag{font-size:10px;color:var(--blue);font-weight:800;text-transform:uppercase;letter-spacing:1px}.product h3{margin:0;font-size:15px}.productDesc{font-size:12px;color:var(--muted);min-height:32px}.price{font-size:18px;color:var(--navy);font-weight:800;margin-top:auto}.productActions{display:flex;gap:8px;margin-top:8px}.add,.buy{border:0;border-radius:10px;padding:10px;font-size:11px;font-weight:800;cursor:pointer}.add{background:var(--navy);color:#fff;flex:1}.buy{background:#e9f8ef;color:#13743d}.customers{background:#fff}.customerGrid{display:flex;gap:18px;overflow:hidden}.customer{min-width:220px;height:300px;border-radius:20px;overflow:hidden;position:relative;background:#eaf2fb;flex:0 0 23%}.customer img{width:100%;height:100%;object-fit:cover}.carouselBtns{display:flex;gap:8px}.about{background:linear-gradient(120deg,#0b2d6b,#154a9e);color:#fff;display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center}.aboutLogo{background:#fff;border-radius:28px;padding:35px;display:grid;place-items:center}.aboutLogo img{width:100%;max-width:330px}.about h2{font-size:48px;line-height:1.05;letter-spacing:-2px}.about p{color:#d3e0f5;line-height:1.8;max-width:650px}.aboutPoints{display:flex;flex-wrap:wrap;gap:12px;margin-top:25px}.aboutPoints span{padding:11px 14px;border:1px solid rgba(255,255,255,.2);border-radius:99px;font-size:12px}.contact{background:#f8fbff}.contactGrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px}.contactCards{display:grid;gap:12px}.contactCards>*,.contactCards>a{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;display:flex;gap:15px;align-items:flex-start}.contactCards span{font-size:23px}.contactCards small{display:block;color:var(--muted);font-size:10px;margin-bottom:5px}.contactCards strong{font-size:13px;line-height:1.5}.socials a{background:var(--navy);color:#fff;padding:9px 12px;border-radius:9px;font-size:11px}.map{min-height:430px;border-radius:22px;overflow:hidden;position:relative;border:1px solid var(--line)}.map iframe{width:100%;height:100%;min-height:430px;border:0}.mapBtn{position:absolute;bottom:18px;right:18px;background:#fff;padding:12px 16px;border-radius:12px;font-size:12px;font-weight:800;box-shadow:0 8px 25px rgba(0,0,0,.15)}footer{background:#071d45;color:#d6e3f5;padding:50px 8% 20px}.footerTop{display:flex;align-items:center;gap:15px;padding-bottom:35px;border-bottom:1px solid rgba(255,255,255,.1)}.footerTop img{width:100px;border-radius:10px}.footerTop div:nth-child(2){display:flex;flex-direction:column;gap:5px}.footerTop strong{color:#fff}.footerTop span{font-size:11px}.footerLinks{margin-left:auto;display:flex;gap:22px;font-size:12px}.footerBottom{display:flex;justify-content:space-between;padding-top:18px;font-size:10px;color:#8da4c5}.floatingWa{position:fixed;right:22px;bottom:22px;width:56px;height:56px;border-radius:50%;background:#1ca65a;color:#fff;display:grid;place-items:center;font-size:25px;box-shadow:0 12px 30px rgba(28,166,90,.3);z-index:25}.drawer,.modal,.intro{position:fixed;inset:0;background:rgba(3,18,42,.55);z-index:60;opacity:1;transition:.25s}.drawer{display:flex;justify-content:flex-end}.drawerPanel{width:min(440px,100%);height:100%;background:#fff;padding:25px;display:flex;flex-direction:column}.drawerHead,.modalPanel{display:flex;justify-content:space-between;align-items:center}.drawerHead button,.modalClose{border:0;background:transparent;font-size:30px;cursor:pointer}.cartLine{display:grid;grid-template-columns:65px 1fr auto;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}.cartLine img{width:65px;height:55px;object-fit:cover;border-radius:9px}.cartLine h4{margin:0 0 5px;font-size:12px}.cartLine small{color:var(--muted)}.cartQty{display:flex;gap:5px;align-items:center}.cartQty button{border:1px solid var(--line);background:#fff;border-radius:6px;width:25px;height:25px}.cartSummary{margin-top:auto;border-top:1px solid var(--line);padding-top:20px}.cartSummary>div{display:flex;justify-content:space-between;margin-bottom:15px}.full{width:100%;border:0;cursor:pointer}.clear{border:0;background:none;color:#d34c4c;font-size:11px;margin-top:12px;cursor:pointer}.modal{display:grid;place-items:center;padding:20px}.modalPanel{width:min(820px,100%);background:#fff;border-radius:25px;overflow:hidden;position:relative;display:grid;grid-template-columns:1fr 1fr}.modalPanel>img{width:100%;height:500px;object-fit:cover}.modalInfo{padding:45px}.modalInfo h2{font-size:32px;margin:12px 0}.modalPrice{font-size:22px;color:var(--navy)}.modalInfo p{color:var(--muted);line-height:1.7}.qty{display:flex;gap:15px;align-items:center;margin:25px 0}.qty button{width:38px;height:38px;border:1px solid var(--line);background:#fff;border-radius:9px;cursor:pointer}.intro{background:#000;display:grid;place-items:center}.intro video{width:100%;height:100%;object-fit:cover}.introShade{position:absolute;inset:0;background:rgba(0,0,0,.15)}#skipIntro{position:absolute;right:25px;bottom:25px;z-index:2;border:1px solid rgba(255,255,255,.5);background:rgba(0,0,0,.35);color:#fff;padding:11px 18px;border-radius:99px;cursor:pointer}.hidden{opacity:0;pointer-events:none}.intro.hidden{display:none}#loader{position:fixed;inset:0;z-index:100;background:linear-gradient(135deg,#fff,#e9f3ff);display:grid;place-items:center;align-content:center;gap:18px;transition:opacity .6s}.#loader{}.loader-tools{position:absolute;font-size:25px;display:flex;gap:150px;color:var(--blue);animation:spin 7s linear infinite}.loader-tools span:nth-child(2){font-size:40px}.#loader img,#loader img{width:240px;height:240px;object-fit:contain;border-radius:28px}.loadbar{width:230px;height:4px;background:#d4e4f8;border-radius:99px;overflow:hidden}.loadbar i{display:block;width:0;height:100%;background:var(--blue);animation:load 1.8s ease forwards}@keyframes load{to{width:100%}}#loader p{font-size:11px;color:var(--muted);letter-spacing:1px}#toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);background:#0b2d6b;color:#fff;padding:12px 17px;border-radius:10px;font-size:12px;opacity:0;pointer-events:none;transition:.3s;z-index:90}#toast.show{opacity:1;transform:translate(-50%,0)}.reveal{animation:reveal .8s ease both}@keyframes reveal{from{opacity:0;transform:translateY(25px)}to{opacity:1;transform:none}}@media(max-width:1000px){.nav{gap:15px}.nav nav{gap:12px}.productGrid{grid-template-columns:repeat(3,1fr)}.catGrid{grid-template-columns:repeat(3,1fr)}.hero{padding:60px 6%}.section{padding:75px 6%}}@media(max-width:760px){.nav{padding:0 4%;height:68px}.brand img{width:105px;height:55px}.nav nav{position:absolute;top:68px;left:0;right:0;background:#fff;display:none;flex-direction:column;padding:20px 5%;border-bottom:1px solid var(--line)}.nav nav.open{display:flex}.menuBtn{display:block}.navActions .waBtn{display:none}.hero{grid-template-columns:1fr;min-height:auto;padding:70px 6% 40px}.heroVisual{height:360px}.hero h1{font-size:54px}.trust{grid-template-columns:repeat(2,1fr);padding:15px 5%}.trust div:nth-child(2){border:0}.sectionHead{align-items:flex-start;flex-direction:column}.shopControls{width:100%;flex-direction:column}.searchBox{width:100%}.productGrid{grid-template-columns:repeat(2,1fr);gap:10px}.productImg{height:160px}.productBody{padding:12px}.productActions{flex-direction:column}.catGrid{grid-template-columns:repeat(3,1fr);gap:8px}.catGrid button{padding:18px 5px;font-size:11px}.about{grid-template-columns:1fr;gap:35px}.about h2{font-size:38px}.contactGrid{grid-template-columns:1fr}.customer{min-width:70%;}.modalPanel{grid-template-columns:1fr}.modalPanel>img{height:280px}.modalInfo{padding:25px}.footerTop{flex-wrap:wrap}.footerLinks{width:100%;margin:10px 0 0;justify-content:space-between}.footerBottom{gap:10px;flex-direction:column}}

/* Premium loader + full-screen intro */
#loader{display:grid;place-items:center;background:radial-gradient(circle at 50% 35%,#ffffff 0%,#eef6ff 55%,#dcecff 100%);transition:opacity .42s ease,visibility .42s ease;}
#loader.done{opacity:0;visibility:hidden;pointer-events:none}
.loaderCard{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center}
.loaderCard strong{font-size:16px;letter-spacing:.8px;color:var(--navy)}
.loaderCard p{margin:0;font-size:10px;color:var(--muted);letter-spacing:.7px}
.loaderRing{width:106px;height:106px;border-radius:50%;padding:5px;position:relative;display:grid;place-items:center;background:#fff;box-shadow:0 14px 38px rgba(11,45,107,.16),0 0 0 1px rgba(24,118,232,.12)}
.loaderRing:before{content:"";position:absolute;inset:-5px;border-radius:50%;border:2px solid transparent;border-top-color:var(--blue);border-right-color:#7fb7f7;animation:loaderSpin 1.15s linear infinite}
.loaderRing:after{content:"";position:absolute;inset:7px;border-radius:50%;border:1px solid rgba(24,118,232,.16)}
.loaderRing img{width:88px;height:88px;border-radius:50%;object-fit:cover;display:block}
@keyframes loaderSpin{to{transform:rotate(360deg)}}
.loadbar{width:170px;height:3px;background:#d7e5f6;border-radius:99px;overflow:hidden}
.loadbar i{height:100%;background:linear-gradient(90deg,var(--navy),var(--blue));animation:load 1s ease forwards}
.intro{background:#000;display:grid;place-items:center;opacity:1;transition:opacity .5s ease}
.intro.closing{opacity:0;pointer-events:none}
.intro video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000;display:block}
.introShade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.08) 55%,rgba(0,0,0,.28));pointer-events:none}
.introTop{position:absolute;top:22px;left:24px;right:24px;z-index:3;display:flex;justify-content:space-between;align-items:center;color:#fff;font-size:12px;font-weight:700;letter-spacing:.6px;text-shadow:0 2px 10px rgba(0,0,0,.45)}
#skipIntro{position:static;border:1px solid rgba(255,255,255,.55);background:rgba(0,0,0,.28);backdrop-filter:blur(12px);color:#fff;padding:10px 16px;border-radius:999px;cursor:pointer;font-size:12px;font-weight:700;transition:.2s}
#skipIntro:hover{background:rgba(255,255,255,.16);transform:translateY(-1px)}
@media(max-width:760px){.loaderRing{width:92px;height:92px}.loaderRing img{width:76px;height:76px}.introTop{top:14px;left:14px;right:14px}.introTop span{font-size:11px}#skipIntro{padding:9px 13px;font-size:11px}}
